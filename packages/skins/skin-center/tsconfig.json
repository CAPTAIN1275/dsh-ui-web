{
  // Standalone compiler shape for the skin-center bundle (self-contained port
  // of the checkout's tsconfig.base.client.json — no monorepo extends).
  // The bundle itself is transpile-only (tsdown, dts: false); this config backs
  // `tsc --noEmit`, which is why the node built-in surface is named explicitly.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "strict": true,
    "noEmit": true
  },
  "include": ["src"]
}
